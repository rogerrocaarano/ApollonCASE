# Optional: Override the diagrams-backend server URLs (default to
# location-relative if unset). In production this location-relative default
# only resolves when something routes /api and /ws at the webapp's own host
# to diagrams-backend - as of containerize-production-stack, Traefik no
# longer does that (diagrams-backend is private), so production deployments
# relying on the location-relative default for loose/shared-by-link diagrams
# will find them unreachable; that regression is accepted, not fixed, by
# that change (see its proposal.md).
# VITE_SERVER_URL=http://localhost:8000
# VITE_SERVER_URL_WSS=ws://localhost:4444/ws

# Keycloak realm the webapp authenticates against (OIDC issuer URL) and the
# public client id registered for the webapp (Standard Flow + PKCE, no secret).
# VITE_KEYCLOAK_AUTHORITY=http://<keycloak-host>:9000/realms/ApollonCASE
# VITE_KEYCLOAK_CLIENT_ID=apolloncase-webapp

# extension-backend has no location-relative default (no default), so it
# always needs an explicit URL - even though, as of
# containerize-production-stack, it IS now Traefik-routed at the webapp's own
# host in production (at the same /api prefix diagrams-backend used to
# occupy). Point this at that same host.
# VITE_EXTENSION_SERVER_URL=http://localhost:8080