# Optional: Override server URLs (defaults to location-relative if unset)
# VITE_SERVER_URL=http://localhost:8000
# VITE_SERVER_URL_WSS=ws://localhost:4444/ws

# Keycloak realm the webapp authenticates against (OIDC issuer URL) and the
# public client id registered for the webapp (Standard Flow + PKCE, no secret).
# VITE_KEYCLOAK_AUTHORITY=http://<keycloak-host>:9000/realms/ApollonCASE
# VITE_KEYCLOAK_CLIENT_ID=apolloncase-webapp

# extension-backend is not proxied by this app (no default), so it always
# needs an explicit URL.
# VITE_EXTENSION_SERVER_URL=http://localhost:8080