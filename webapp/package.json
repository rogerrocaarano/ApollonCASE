{
  "name": "@tumaet/webapp",
  "private": true,
  "version": "5.3.0",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "start": "npm run build:css --workspace=@tumaet/ui && npx concurrently -k \"npm run build:css:watch --workspace=@tumaet/ui\" \"vite\"",
    "start:host": "npm run build:css --workspace=@tumaet/ui && npx concurrently -k \"npm run build:css:watch --workspace=@tumaet/ui\" \"vite --host\"",
    "build": "npm run build:css --workspace=@tumaet/ui && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit",
    "storybook": "npm run build:css --workspace=@tumaet/ui && storybook dev -p 6006",
    "build-storybook": "npm run build:css --workspace=@tumaet/ui && storybook build",
    "test:storybook": "vitest run --config vitest.config.storybook.ts",
    "pw": "node node_modules/@playwright/test/cli.js",
    "test:e2e": "node node_modules/@playwright/test/cli.js test tests/e2e/",
    "test:e2e:ui": "node node_modules/@playwright/test/cli.js test tests/e2e/ --ui",
    "test:e2e:firefox": "PLAYWRIGHT_FIREFOX=1 node node_modules/@playwright/test/cli.js test tests/e2e/ --project=firefox",
    "test:perf": "node node_modules/@playwright/test/cli.js test --project=perf",
    "test:perf:firefox": "PLAYWRIGHT_FIREFOX=1 node node_modules/@playwright/test/cli.js test --project=perf-firefox",
    "test:visual": "node node_modules/@playwright/test/cli.js test tests/visual/",
    "test:visual:update": "node node_modules/@playwright/test/cli.js test tests/visual/ --update-snapshots",
    "appstore:screenshots": "bundle exec fastlane screenshots",
    "appstore:screenshots:framed": "bundle exec fastlane framed_screenshots",
    "appstore:screenshots:prepare-frames": "app-store-screenshots/prepare-official-device-frames.sh",
    "appstore:screenshots:preview": "npm run build --workspace=@tumaet/apollon && playwright test --config playwright.app-store.config.ts",
    "appstore:metadata:validate": "node app-store-screenshots/validate-metadata.mjs",
    "live-update:build": "node scripts/build-live-update.mjs",
    "capacitor:add:android": "cap add android",
    "capacitor:add:ios": "cap add ios --packagemanager CocoaPods",
    "capacitor:sync": "cap sync",
    "capacitor:open:android": "cap open android",
    "capacitor:open:ios": "cap open ios",
    "capacitor:assets:generate:ios": "capacitor-assets generate --ios",
    "capacitor:assets:generate:android": "capacitor-assets generate --android"
  },
  "dependencies": {
    "@capacitor/android": "8.4.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.4.1",
    "@capacitor/file-transfer": "2.0.4",
    "@capacitor/filesystem": "8.1.2",
    "@capacitor/ios": "8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "8.0.1",
    "@capacitor/splash-screen": "8.0.1",
    "@capacitor/status-bar": "8.0.2",
    "@capgo/capacitor-updater": "^8.51.2",
    "@resvg/resvg-wasm": "2.6.2",
    "@tailwindcss/vite": "4.3.1",
    "@tanstack/history": "1.162.0",
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.16",
    "@tumaet/apollon": "*",
    "@tumaet/ui": "*",
    "@xyflow/react": "12.11.1",
    "clsx": "2.1.1",
    "idb": "8.0.3",
    "jspdf": "4.2.1",
    "lucide-react": "1.22.0",
    "oidc-client-ts": "^3.5.0",
    "pptxgenjs": "4.0.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "react-oidc-context": "^3.3.1",
    "react-toastify": "11.1.0",
    "remark-gfm": "4.0.1",
    "semver": "^7.8.5",
    "svg2pdf.js": "2.7.0",
    "tailwindcss": "4.3.1",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "3.0.5",
    "@capacitor/cli": "8.4.1",
    "@capgo/cli": "^8.29.1",
    "@eslint-react/eslint-plugin": "5.9.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@resvg/resvg-js": "2.6.2",
    "@size-limit/file": "12.1.0",
    "@storybook/addon-a11y": "10.4.6",
    "@storybook/addon-docs": "10.4.6",
    "@storybook/addon-themes": "10.4.6",
    "@storybook/addon-vitest": "10.4.6",
    "@storybook/react-vite": "10.4.6",
    "@tanstack/eslint-plugin-query": "5.100.4",
    "@tanstack/react-query-devtools": "5.101.2",
    "@tanstack/router-plugin": "1.168.18",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.0.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/semver": "^7.7.1",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/browser": "4.1.9",
    "@vitest/browser-playwright": "4.1.9",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fake-indexeddb": "6.2.5",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "jszip": "3.10.1",
    "playwright": "1.61.1",
    "size-limit": "12.1.0",
    "storybook": "10.4.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.0",
    "vite": "8.1.0",
    "vitest": "4.1.9",
    "yjs": "13.6.31"
  },
  "size-limit": [
    {
      "name": "all JS incl. on-demand export chunks (gzipped) — regression ceiling; MUI/Emotion removal is separately enforced by the no-mui-emotion check",
      "path": "dist/assets/*.js",
      "gzip": true,
      "limit": "1300 kB"
    },
    {
      "name": "all CSS (gzipped) — regression ceiling; the MUI/Emotion→shadcn migration moved runtime CSS-in-JS into static CSS (one-time step up), so the budget tracks the static stylesheet, not the old Emotion baseline. The 37 kB ceiling includes the integration UI for assessment navigation, fullscreen portals, and larger pointer targets while retaining less than 1 kB of headroom",
      "path": "dist/assets/*.css",
      "gzip": true,
      "limit": "37 kB"
    }
  ]
}
