spring.datasource.url=jdbc:postgresql://host:port/db
spring.datasource.username=user
spring.datasource.password=password
spring.jpa.hibernate.ddl-auto=update

spring.security.oauth2.resourceserver.jwt.issuer-uri=http://<keycloak-host>:9000/realms/ApollonCASE

# Origin(s) the webapp is served from, for CORS.
app.cors.allowed-origins=http://localhost:5173,http://localhost:8080

# diagrams-backend, for proxying a project diagram's body/versions and relaying its collaboration WebSocket.
app.diagrams-backend.base-url=http://localhost:8000
app.diagrams-backend.ws-base-url=ws://localhost:4444