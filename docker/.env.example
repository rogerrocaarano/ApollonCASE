# Environment variables for the production Docker Compose stack
# (compose.production.yml): Postgres, Redis, diagrams-backend,
# extension-backend, webapp. No reverse proxy is included - deploy behind
# Dokploy (or any other proxy/PaaS) and point its domain(s) at the
# `webapp` and `extension-backend` services' port 8080.
#
# Copy this file to `.env` in this directory and fill in real values.
# Docker Compose loads `.env` automatically for files in the same directory.

# --- Postgres (Redis + Postgres, private/apollon-internal only) ---

# Postgres database/user for extension-backend. DB/user have safe defaults
# for a single-tenant deployment; the password has none and must be set.
# POSTGRES_DB=apolloncase
# POSTGRES_USER=apolloncase
POSTGRES_PASSWORD=

# --- webapp / diagrams-backend / extension-backend ---
# All three are built from this repo's own Dockerfiles (see
# docker-compose.production.yml's `build:` blocks) - no image tag to pin,
# since there's no registry pull involved.

# Bundled legal profile (imprint + privacy) the webapp serves. See
# docs/admin/legal-pages.md. Optional; an empty/unset value serves the
# built-in disclaimer, which upstream Apollon documents as not valid for
# production use.
# LEGAL_PROFILE=

# Host directory mounted read-only into the webapp container at
# /usr/share/nginx/html/live-updates, for iOS over-the-air update bundles.
# Optional; an absent directory just yields 404s for that feature.
# LIVE_UPDATE_DIR=/opt/apollon/app/live-updates

# Secret diagrams-backend uses to sign its diagram-owner cookie. Required,
# at least 32 characters.
OWNER_SECRET=

# Origins allowed to call diagrams-backend and extension-backend directly
# (CORS). Optional; each service falls back to its own local-dev default if
# unset. Set this to the webapp's real origin (the domain Dokploy assigns it)
# in production.
# CORS_ORIGIN=https://your-app-domain

# OIDC issuer URL of the externally-managed Keycloak realm extension-backend
# validates JWTs against. Keycloak itself is NOT part of this compose stack -
# see add-keycloak-auth and containerize-production-stack's design.md.
# Required. Example, matching a keycloak.<domain> / app.<domain> /
# api.<domain> split across three subdomains:
# ISSUER_URI=https://keycloak.your-domain.com/realms/ApollonCASE
ISSUER_URI=

# --- webapp build-time variables (Vite - baked into the static bundle at
# `docker compose build`, passed as build args to webapp/Dockerfile; see its
# own comment on why these can't be plain container-runtime variables like
# LEGAL_PROFILE above). All optional, but the webapp can't reach
# extension-backend or offer login without them in a real deployment. ---

# Same realm as ISSUER_URI above - the webapp needs it too, to start the
# OIDC login redirect from the browser. Required for login to work.
# VITE_KEYCLOAK_AUTHORITY=https://keycloak.your-domain.com/realms/ApollonCASE
VITE_KEYCLOAK_AUTHORITY=

# Public client id (Standard Flow + PKCE, no secret) registered for the
# webapp in that realm. Has a default matching the id this repo's own docs
# already assume; override if your realm registers it under a different name.
VITE_KEYCLOAK_CLIENT_ID=apolloncase-webapp

# extension-backend's own public URL - the webapp calls this directly from
# the browser for every project/diagram/API request and its collaboration
# WebSocket (derived from this by swapping http(s) for ws(s), see
# webapp/src/constants/urls.ts). Required for the webapp to actually work;
# there is no same-origin fallback that works once webapp and
# extension-backend are on different domains (the normal case with Dokploy).
# VITE_EXTENSION_SERVER_URL=https://api.your-domain.com
VITE_EXTENSION_SERVER_URL=
