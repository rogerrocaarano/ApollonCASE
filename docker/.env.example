# Environment variables for the production Docker Compose stack
# (compose.production.yml): Postgres, Redis, diagrams-backend,
# extension-backend, webapp. No reverse proxy is included - deploy behind
# Dokploy (or any other proxy/PaaS) and point its domain(s) at the
# `webapp` and `extension-backend` services' port 8080.
#
# Copy this file to `.env` in this directory and fill in real values.
# Docker Compose loads `.env` automatically for files in the same directory.

# --- Postgres (Redis + Postgres, private/apollon-internal only) ---

# Postgres database/user for extension-backend. DB/user have safe defaults
# for a single-tenant deployment; the password has none and must be set.
# POSTGRES_DB=apolloncase
# POSTGRES_USER=apolloncase
POSTGRES_PASSWORD=

# --- webapp / diagrams-backend / extension-backend ---

# Image tag for the upstream Apollon webapp/diagrams-backend images
# (ghcr.io/ls1intum/apollon/*). Optional, defaults to "latest".
# IMAGE_TAG=latest

# Bundled legal profile (imprint + privacy) the webapp serves. See
# docs/admin/legal-pages.md. Optional; an empty/unset value serves the
# built-in disclaimer, which upstream Apollon documents as not valid for
# production use.
# LEGAL_PROFILE=

# Host directory mounted read-only into the webapp container at
# /usr/share/nginx/html/live-updates, for iOS over-the-air update bundles.
# Optional; an absent directory just yields 404s for that feature.
# LIVE_UPDATE_DIR=/opt/apollon/app/live-updates

# Secret diagrams-backend uses to sign its diagram-owner cookie. Required,
# at least 32 characters.
OWNER_SECRET=

# Origins allowed to call diagrams-backend and extension-backend directly
# (CORS). Optional; each service falls back to its own local-dev default if
# unset. Set this to the webapp's real origin (the domain Dokploy assigns it)
# in production.
# CORS_ORIGIN=https://your-app-domain

# OIDC issuer URL of the externally-managed Keycloak realm extension-backend
# validates JWTs against (e.g. https://keycloak.example.com/realms/ApollonCASE).
# Keycloak itself is NOT part of this compose stack - see add-keycloak-auth
# and containerize-production-stack's design.md. Required.
ISSUER_URI=

# --- webapp build-time variables (NOT consumed by this compose file) ---
# The webapp image is pulled pre-built from ghcr.io; these are baked in (or
# supplied at container start via its own env.js mechanism) when that image
# is built/run, documented here only so every variable the full deployment
# needs is in one place. See webapp/.env.example.
#
# VITE_KEYCLOAK_AUTHORITY=https://keycloak.example.com/realms/ApollonCASE
# VITE_KEYCLOAK_CLIENT_ID=apolloncase-webapp
# VITE_EXTENSION_SERVER_URL=https://your-app-domain
